<!-- Solr managed schema - automatically generated - DO NOT EDIT -->
<!--
  The banner above is the one Solr really writes, and the demo opens by confronting it: the
  plugin's whole position is that you edit this file anyway.

  The dangling `manufacturer` copyField at the bottom is DELIBERATE and must not be fixed:
  it is the inspection demo. Several other deliberate defects live in the Java sources.
  See demo/README.md.

  `version="1.6"` below is DELIBERATE too. Solr 9.7 introduced schema version 1.7, which
  turned docValues on and uninvertible off by default and left every earlier schema alone —
  and moving a schema up generally means re-indexing, so 1.6 is where a great many real
  configsets still sit. Staying here is what makes the demo show a version-dependent default
  being resolved against the file rather than asserted. Bumping it to 1.7 silently removes
  that from the demo.

  `notes` (type `custom_text`) and `legacy` (type `discontinued`), near the end of the field
  list, are DELIBERATE too, and demonstrate the inlay hint's two different silences. `notes`
  hits an analyser chain the plugin does not recognise, so its hint keeps the storage-shape
  phrases and drops only the match claim. `legacy` names a type the schema never declares, so
  its hint drops everything — resolution has no field type to fall back on, and guessing would
  attribute a default to Solr that the missing type might have overridden. `legacy` is also a
  second reportable finding beside the dangling copyField below; see the manual test suite's
  BASE-1.
-->
<schema name="products" version="1.6">

  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>

  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>

  <fieldType name="text_prefix" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.EdgeNGramFilterFactory" minGramSize="2" maxGramSize="15"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- DELIBERATE: com.example.MyTokenizerFactory does not exist. This is what an unrecognised
       analyser chain looks like to the inlay hint: `notes` below keeps its storage-shape
       phrases and drops only the match claim, because storage properties never depended on
       understanding the chain. -->
  <fieldType name="custom_text" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="com.example.MyTokenizerFactory"/>
    </analyzer>
  </fieldType>

  <field name="id"          type="string"       indexed="true"  stored="true" required="true"/>
  <field name="sku"         type="string"       indexed="true"  stored="true"/>
  <field name="name"        type="text_general" indexed="true"  stored="true"/>
  <field name="name_prefix" type="text_prefix"  indexed="true"  stored="false"/>
  <field name="category"    type="string"       indexed="true"  stored="true"/>
  <field name="description" type="text_general" indexed="true"  stored="true"/>
  <field name="text"        type="text_general" indexed="true"  stored="false" multiValued="true"/>
  <field name="notes"       type="custom_text"  indexed="true"  stored="true"/>
  <!-- DELIBERATE: no such type. This is the undeclared-field-type inspection demo. Unlike
       `notes` above, resolution has no field type to fall back on at all here, so the inlay
       hint stays silent rather than guessing at a default the type might have overridden. -->
  <field name="legacy"      type="discontinued" indexed="true"  stored="true"/>

  <uniqueKey>id</uniqueKey>

  <copyField source="name"         dest="text"/>
  <copyField source="description"  dest="text"/>
  <copyField source="name"         dest="name_prefix"/>
  <!-- DELIBERATE: no such field. This is the dangling-reference inspection demo. -->
  <copyField source="manufacturer" dest="text"/>
</schema>
