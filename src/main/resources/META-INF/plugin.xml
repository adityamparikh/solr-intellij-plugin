<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.apache.solr.ide</id>
    <name>Apache Solr</name>
    <vendor>Apache Software Foundation</vendor>
    <description><![CDATA[
        <p>IDE tooling for Apache Solr development. Phase 1 provides static-analysis language
        intelligence for Solr configsets (managed-schema/schema.xml, solrconfig.xml): completion,
        cross-file navigation, rename refactoring, inspections, and match-capability hints —
        with no Solr connection required.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Configset XML PSI: reference resolution, inspections, completion over schema.xml/solrconfig.xml -->
    <depends>com.intellij.modules.xml</depends>
    <!-- Phase 3 (SolrJ in Java/Kotlin): <depends>com.intellij.modules.java</depends> -->

    <resource-bundle>messages.SolrBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Associate the extensionless `managed-schema` (and newer `managed-schema.xml`) with the
             XML file type so configsets are parsed as XML for later PSI-based features. -->
        <fileType name="XML" fileNames="managed-schema;managed-schema.xml"/>

        <!-- What each field can actually match, shown inline beside its declaration. An inlay
             rather than a tooltip on purpose: a user who does not already suspect their field
             cannot match a prefix will never hover over it to find out. -->
        <codeInsight.declarativeInlayProvider
            language="XML"
            providerId="solr.match.capability"
            bundle="messages.SolrBundle"
            nameKey="inlay.matchCapability.name"
            group="OTHER_GROUP"
            isEnabledByDefault="true"
            implementationClass="org.apache.solr.ide.editor.SolrMatchInlayHintsProvider"/>

        <!-- Quick documentation on a field or its type, resolving each property's effective value
             and where it came from. -->
        <lang.documentationProvider
            language="XML"
            implementationClass="org.apache.solr.ide.editor.SolrConfigsetDocumentationProvider"/>

        <!-- Inspections. Warning rather than error: the plugin's model of a half-typed file is not
             authoritative enough to claim a hard error, and an error on a file the user is midway
             through editing is worse than a warning on the same file. -->
        <localInspection
            language="XML"
            shortName="SolrDanglingCopyField"
            bundle="messages.SolrBundle"
            key="inspection.copyField.displayName"
            groupBundle="messages.SolrBundle"
            groupKey="inspection.group"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="org.apache.solr.ide.editor.SolrDanglingCopyFieldInspection"/>
        <localInspection
            language="XML"
            shortName="SolrUnknownFieldType"
            bundle="messages.SolrBundle"
            key="inspection.fieldType.displayName"
            groupBundle="messages.SolrBundle"
            groupKey="inspection.group"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="org.apache.solr.ide.editor.SolrUnknownFieldTypeInspection"/>
    </extensions>
</idea-plugin>
