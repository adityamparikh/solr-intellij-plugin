<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.apache.solr.ide</id>
    <name>Apache Solr</name>
    <vendor>Apache Software Foundation</vendor>
    <!-- Shown on the JetBrains Marketplace and in Settings → Plugins, so it is written for someone
         deciding whether to install rather than for someone who already has. Kept honest about the
         boundary: this release reads files and never opens a socket, and saying so is the feature. -->
    <description><![CDATA[
        <h2>Solr configsets, understood by the IDE</h2>

        <p>Editing <code>managed-schema.xml</code> and <code>solrconfig.xml</code> is usually editing
        XML with no help at all — the mistakes surface when a core fails to reload, or quietly, when a
        query returns nothing and nobody can say why. This plugin reads a configset the way the IDE
        reads any other language.</p>

        <ul>
          <li><b>Completion</b> that knows Solr's own vocabulary — field types and their classes,
              analyzer factories and the attributes each one actually reads, the elements
              <code>solrconfig.xml</code> accepts, request parameter names, and the field names a
              handler's <code>qf</code> or <code>fl</code> may hold.</li>
          <li><b>Inspections</b> for what is provably wrong: a dangling <code>copyField</code>, a
              field naming a type nobody declared, a handler naming a field the schema does not have,
              an analyzer chain whose filter can never run, an element Solr no longer accepts.</li>
          <li><b>Navigation and rename</b> across the whole configset — Ctrl-click a type to its
              declaration, Find Usages from a declaration, rename a field and have every reference
              follow.</li>
          <li><b>Quick documentation</b> on every position a caret can sit: a field's resolved
              properties and where each value came from, a class's kind and attributes, an attribute's
              meaning, a request parameter's purpose.</li>
          <li><b>Match-capability hints</b> beside each field, stating what it can actually match —
              derived from the real analyzer chain, not guessed from the type's name.</li>
        </ul>

        <p><b>Nothing here needs a running Solr.</b> No connection to configure, nothing sent
        anywhere: every answer comes from the files in your project and from Solr's own jars, read at
        build time. Talking to a live server — browsing collections, running queries, comparing a
        configset against what a server is really running — is the next release.</p>

        <p>Facts come from Solr or are not claimed. Where the plugin cannot be certain, it says
        nothing rather than guessing, and every inspection is checked against the configsets Apache
        Solr itself ships to make sure a correct file draws no warnings.</p>

        <p><i>An independent open-source project. Not affiliated with or endorsed by the Apache
        Software Foundation.</i></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Configset XML PSI: reference resolution, inspections, completion over schema.xml/solrconfig.xml -->
    <depends>com.intellij.modules.xml</depends>
    <!-- Java PSI, for resolving the class a `class` attribute names.

         Hard rather than optional, because the plugin targets IntelliJ IDEA and nothing else. It was
         optional, with its one registration held in a separate `solr-withJava.xml`, so that the
         plugin would load in an IDE without Java support and simply lack class navigation there.
         Nothing verified that, and nothing needed to: IDEA has been a single unified distribution
         since 2025.3 and bundles Java, so the condition was true in every IDE that would ever run
         this. A conditional branch that cannot be taken is not portability, it is a claim.

         Phase 3 (SolrJ in Java/Kotlin) needs this unconditionally in any case. -->
    <depends>com.intellij.modules.java</depends>

    <!-- The IDE's own HTTP Client, which is where saved Solr queries live and run. Hard rather
         than optional, on the same grounds as the Java dependency above: `restClient` ships in the
         same unified distribution this plugin targets and carries no `<product-descriptor>`, so it
         is not separately licensed, and the condition is true in every IDE that would ever run this.
         Written down because an unstated dependency is how a feature disappears on somebody's
         machine for reasons nobody can reconstruct. -->
    <depends>com.jetbrains.restClient</depends>

    <resource-bundle>messages.SolrBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Associate the extensionless `managed-schema` (and newer `managed-schema.xml`) with the
             XML file type so configsets are parsed as XML for later PSI-based features. -->
        <fileType name="XML" fileNames="managed-schema;managed-schema.xml"/>

        <!-- Where a Solr server gets configured. A `projectConfigurable` rather than an
             `applicationConfigurable` because connections persist to the workspace file: the URL may
             be a personal port-forward and the credential is personal by definition, so they are a
             fact about one developer's checkout rather than about the team. Offering them globally
             would be offering to edit something the storage does not hold.

             Under the Tools group, which is where the other server-backed tools in the IDE put
             theirs, and not under Languages & Frameworks — nothing here affects how a file is read. -->
        <!-- Starting requests for querying Solr, offered in the HTTP Client's Add Request menu.
             This is another plugin's extension point rather than platform API: it may be
             undocumented and may change between releases, and `verifyPlugin` against every entry in
             `verifiedIdeBuilds` is what makes such a change fail a pull request raising the target
             rather than a user's editor. -->
        <!-- A readable summary above a Solr query's raw JSON. Registered with no applicability
             attribute because the extension point has none: it is called for every response the
             HTTP Client shows, including other plugins', and decides for itself. Declining is
             therefore the common case, and `SolrQueryResultReader` decides from the response body
             rather than from the URL — Solr behind a reverse proxy is addressed at any path, and a
             non-Solr service may expose one called `/select`. -->
        <!-- Field names inside a Solr query body written in an `.http` file. Registered against
             JSON because the HTTP Client already injects JSON into a body carrying that
             Content-Type, so this contributes to an injection that is already there rather than
             arranging one. Every JSON file in the project reaches it, which is why it declines in
             three steps before offering anything — see the class comment. -->
        <completion.contributor
                language="JSON"
                implementationClass="org.apache.solr.ide.server.query.SolrQueryFieldCompletionContributor"/>

        <httpClient.responseCustomPresentation
                implementation="org.apache.solr.ide.server.query.SolrQueryResponsePresentation"/>

        <httpClient.addRequestTemplateProvider
                implementation="org.apache.solr.ide.server.query.SolrRequestTemplateProvider"/>

        <!-- What the selected server actually holds. Under `toolWindow` rather than a dialog because
             browsing a topology is something a developer does alongside editing a configset, not
             instead of it. `anchor="right"` keeps it out of the way of the Project view, which is
             where the configset being compared against it lives.

             `canCloseContents="false"`: there is one tab and closing it would leave an empty tool
             window with no way back to it. -->
        <toolWindow
                id="Solr"
                factoryClass="org.apache.solr.ide.server.topology.SolrCollectionsToolWindowFactory"
                anchor="right"
                canCloseContents="false"/>

        <projectConfigurable
                parentId="tools"
                id="solr.connections"
                bundle="messages.SolrBundle"
                key="settings.connections.displayName"
                instance="org.apache.solr.ide.server.connection.SolrConnectionsConfigurable"/>

        <!-- What each field can actually match, shown inline beside its declaration. An inlay
             rather than a tooltip on purpose: a user who does not already suspect their field
             cannot match a prefix will never hover over it to find out. -->
        <codeInsight.declarativeInlayProvider
                language="XML"
                providerId="solr.match.capability"
                bundle="messages.SolrBundle"
                nameKey="inlay.matchCapability.name"
                group="OTHER_GROUP"
                isEnabledByDefault="true"
                implementationClass="org.apache.solr.ide.configset.schema.hint.SolrMatchInlayHintsProvider"/>

        <!-- Dimming for an attribute the field would have had anyway. An annotator rather than an
             inspection because a restated default is correct: it is rendered like redundant code and
             reaches neither the Problems view nor any problem count. The removal intention below is
             what acts on it, and only when the reader asks. -->
        <annotator
                language="XML"
                implementationClass="org.apache.solr.ide.configset.schema.annotator.SolrRestatedDefaultAnnotator"/>

        <!-- Element descriptors for schema files. A schema has no XSD, so without these the
             platform guesses: attribute completion echoes whatever same-named sibling tags carry.
             The descriptors are deliberately permissive — validation stays with the inspections. -->
        <xml.elementDescriptorProvider
                implementation="org.apache.solr.ide.configset.schema.descriptor.SolrSchemaElementDescriptorProvider"/>

        <!-- The same job for the other file, and a second provider rather than a widened first one:
             a gate serving both would make one aspect the owner of a position the other also has.
             Without it the platform guesses here too, and this file is the worst case for the guess
             because it is made of same-named tags — a second <requestHandler> was offered whatever
             the first one happened to carry. -->
        <xml.elementDescriptorProvider
                implementation="org.apache.solr.ide.configset.solrconfig.descriptor.SolrConfigElementDescriptorProvider"/>

        <!-- Quick documentation, answering a different question at each position. On a field, its
             type, or a factory tag, it resolves the values in effect and where each came from; on a
             factory attribute it states only what the catalog can prove — owner, value type,
             default or required — and stays silent beyond it; on a class value it answers what the
             class is and what it accepts, which is identity rather than resolution. -->
        <lang.documentationProvider
                language="XML"
                implementationClass="org.apache.solr.ide.configset.schema.documentation.SolrSchemaDocumentationProvider"/>

        <!-- `solrconfig.xml`'s two answerable positions, which the schema provider declines: what a
             request parameter is for, and what a `defType` value selects. Registered second, so a
             position both could claim goes to the older one; in practice neither claims the other's,
             because each declines unless its own resource carries the name under the caret. -->
        <lang.documentationProvider
                language="XML"
                implementationClass="org.apache.solr.ide.configset.solrconfig.documentation.SolrConfigDocumentationProvider"/>

        <!-- References. A configset is held together by string references — a field names its
             type, a copyField names two fields — and none of them is a reference as far as the
             editor is concerned until this makes it one. -->
        <psi.referenceContributor
                language="XML"
                implementation="org.apache.solr.ide.configset.schema.reference.SolrSchemaReferenceContributor"/>
        <!-- The solrconfig.xml half, registered separately: it answers for a different file and a
             different element, and each contributor is consulted for every XML file in the project,
             so narrower patterns cost less to decline. -->
        <psi.referenceContributor
                language="XML"
                implementation="org.apache.solr.ide.configset.solrconfig.reference.SolrConfigReferenceContributor"/>
        <!-- The `class` attribute, in both files, resolved to the class it names. The one thing in
             this plugin that touches Java PSI, which is why it lived in a separate descriptor behind
             an optional dependency until that dependency became a hard one. -->
        <psi.referenceContributor
                language="XML"
                implementation="org.apache.solr.ide.configset.navigation.SolrClassReferenceContributor"/>

        <!-- The other end of those references. The contributor above anchors every reference at a
             use site, which makes Ctrl-click work and left Find Usages refusing from the
             declaration: the platform had no way to turn that caret into something to search for.
             No language attribute — declaration searchers are registered globally and decline by
             inspecting the element, which the configset guard already does. -->
        <pom.declarationSearcher
                implementation="org.apache.solr.ide.configset.navigation.SolrDeclarationSearcher"/>

        <!-- A dynamic field supplies names it never spells, and the word index can only offer
             candidates that share a word with the pattern. Without this, Find Usages on
             <dynamicField name="*_t"> silently omits every name it actually supplies. Global and
             declining first, for the same reason as above. -->
        <referencesSearch
                implementation="org.apache.solr.ide.configset.navigation.SolrDynamicFieldSearcher"/>

        <!-- What the two above look like once the platform renders them. Without the first, the
             Find Usages header and the rename dialog read "Solr Declaration Target" — the target's
             own class name, which is the platform's fallback. Without the second, every usage lands
             under "Unclassified". Both were found by a sandbox pass; neither is visible to a test
             that asserts what the search returns. -->
        <elementDescriptionProvider
                implementation="org.apache.solr.ide.configset.navigation.SolrDeclarationDescriptionProvider"/>
        <usageTypeProvider
                implementation="org.apache.solr.ide.configset.navigation.SolrUsageTypeProvider"/>

        <!-- Completion for the attribute values whose valid answers are a closed set. Positions
             where any value is legal are left to the platform, because a partial list implies the
             values not on it are wrong. -->
        <!-- order="first" so the vocabulary provider runs ahead of the platform's XML contributor
             and can drop the bare duplicates of names it already offered with summaries. -->
        <completion.contributor
                language="XML"
                order="first"
                implementationClass="org.apache.solr.ide.configset.schema.completion.SolrSchemaCompletionContributor"/>
        <!-- Field names inside a solrconfig.xml handler parameter's text, which is the one
             answerable position that is neither an attribute value nor a tag name. -->
        <completion.contributor
                language="XML"
                implementationClass="org.apache.solr.ide.configset.solrconfig.completion.SolrConfigCompletionContributor"/>

        <!-- Inspections. Warning rather than error: the plugin's model of a half-typed file is not
             authoritative enough to claim a hard error, and an error on a file the user is midway
             through editing is worse than a warning on the same file. -->
        <localInspection
                language="XML"
                shortName="SolrDanglingCopyField"
                bundle="messages.SolrBundle"
                key="inspection.copyField.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.schema.inspection.SolrDanglingCopyFieldInspection"/>
        <localInspection
                language="XML"
                shortName="SolrUnknownFieldType"
                bundle="messages.SolrBundle"
                key="inspection.fieldType.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.schema.inspection.SolrUnknownFieldTypeInspection"/>
        <!-- Value and attribute-name checks. Both read the generated catalog, so both are silent on
             a class it does not know: a custom plugin must not be underlined for being custom. -->
        <localInspection
                language="XML"
                shortName="SolrInvalidAttributeValue"
                bundle="messages.SolrBundle"
                key="inspection.attributeValue.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.schema.inspection.SolrInvalidAttributeValueInspection"/>
        <localInspection
                language="XML"
                shortName="SolrUnknownAttribute"
                bundle="messages.SolrBundle"
                key="inspection.attribute.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.schema.inspection.SolrUnknownAttributeInspection"/>
        <localInspection
                language="XML"
                shortName="SolrUnknownFieldReference"
                bundle="messages.SolrBundle"
                key="inspection.fieldReference.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.solrconfig.inspection.SolrUnknownFieldReferenceInspection"/>
        <!-- Reads the same handler parameters as the check above and asks the next question of them:
             the field is declared, but can it be searched? Separate rather than folded in, because a
             user who trusts one may not want the other — and because the two examine different
             parameter sets, `qf` and the phrase fields alone rather than everything naming a field. -->
        <localInspection
                language="XML"
                shortName="SolrNonIndexedRelevanceField"
                bundle="messages.SolrBundle"
                key="inspection.nonIndexedRelevanceField.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.solrconfig.inspection.SolrNonIndexedRelevanceFieldInspection"/>
        <!-- The one inspection here that guards against silence rather than against a false positive:
             a facet or sort naming a field with neither doc values nor an un-invertible index is a
             request Solr refuses outright, and nothing in the configset says so. Separate from the
             check above because searching and faceting want different structures — a field can be
             searchable and unfacetable — and because the parameter sets do not overlap. -->
        <localInspection
                language="XML"
                shortName="SolrUnsupportedFieldOperation"
                bundle="messages.SolrBundle"
                key="inspection.unsupportedFieldOperation.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.solrconfig.inspection.SolrUnsupportedFieldOperationInspection"/>
        <!-- The hardest schema defect to see by reading: every class exists and every attribute is
             legal, and the filter still never runs. Registered for XML like the rest; both rules it
             carries are provable from the order of the chain alone. -->
        <localInspection
                language="XML"
                shortName="SolrAnalyzerChainOrder"
                bundle="messages.SolrBundle"
                key="inspection.analyzerChainOrder.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.schema.inspection.SolrAnalyzerChainOrderInspection"/>
        <!-- The one finding here that is not a defect: a type nothing uses is dead weight, not a
             mistake, so it is drawn as an unused declaration rather than underlined. Enabled by
             default all the same — the grey-out costs a reader nothing, and dead configuration is
             how a schema becomes unreadable. -->
        <localInspection
                language="XML"
                shortName="SolrUnusedFieldType"
                bundle="messages.SolrBundle"
                key="inspection.unusedFieldType.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.schema.inspection.SolrUnusedFieldTypeInspection"/>

        <!-- The one finding in this file that is not advice: four of the five elements Solr retired
             stop the core starting. Reported in Solr's own words, because the sentence names the
             replacement and a paraphrase would drop it. -->
        <localInspection
                language="XML"
                shortName="SolrDiscontinuedElement"
                bundle="messages.SolrBundle"
                key="inspection.discontinuedElement.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.solrconfig.inspection.SolrDiscontinuedElementInspection"/>

        <!-- The one rule the parameter catalog can prove wrong: a name that is almost one Solr
             reads. Never an unrecognised name on its own — this file accepts components from
             outside Solr, so absence proves nothing. -->
        <localInspection
                language="XML"
                shortName="SolrMisspelledParameter"
                bundle="messages.SolrBundle"
                key="inspection.parameter.displayName"
                groupBundle="messages.SolrBundle"
                groupKey="inspection.group"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="org.apache.solr.ide.configset.solrconfig.inspection.SolrMisspelledParameterInspection"/>

        <!-- An intention rather than an inspection quick-fix, because a field without prefix
             support is correct Solr. Underlining it would be manufacturing a problem in order to
             have somewhere to hang the fix; an intention carries no claim that anything is wrong. -->
        <intentionAction>
            <language>XML</language>
            <category>Solr</category>
            <className>org.apache.solr.ide.configset.schema.intention.SolrAddPrefixCompanionIntention</className>
        </intentionAction>
        <intentionAction>
            <language>XML</language>
            <category>Solr</category>
            <className>org.apache.solr.ide.configset.schema.intention.SolrAddExactCompanionIntention</className>
        </intentionAction>
        <!-- The companion to the dim above. Offered rather than applied, because restating a default
             is correct and sometimes deliberate — the plugin reports that removing it changes
             nothing and leaves the choice to the reader. -->
        <intentionAction>
            <language>XML</language>
            <category>Solr</category>
            <className>org.apache.solr.ide.configset.schema.intention.SolrRemoveRestatedAttributeIntention</className>
        </intentionAction>
    </extensions>
</idea-plugin>
